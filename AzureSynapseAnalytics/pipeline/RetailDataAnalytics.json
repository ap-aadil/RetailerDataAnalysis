{
	"name": "RetailDataAnalytics",
	"properties": {
		"activities": [
			{
				"name": "Lookup1",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_SqlServerTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup1').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "getTableName",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "tablename",
								"value": {
									"value": "@item().table_name",
									"type": "Expression"
								}
							}
						},
						{
							"name": "getIngetionCol",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "getTableName",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "ingetioncol",
								"value": {
									"value": "@item().incremental_col",
									"type": "Expression"
								}
							}
						},
						{
							"name": "getIngetioindt",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "getIngetionCol",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "ingetiondt",
								"value": {
									"value": "@item().ingestion_dt",
									"type": "Expression"
								}
							}
						},
						{
							"name": "getFilename",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "getFolderName",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "filename",
								"value": {
									"value": "@concat(variables('tablename'),'_',formatDateTime(variables('ingetiondt'),'ddMMyyyy'),'.json')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "getFolderName",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "getIngetioindt",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "foldername",
								"value": {
									"value": "@variables('tablename')",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "getQury",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@variables('qury')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "DS_SqlServerTable1",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "Json1",
						"type": "DatasetReference",
						"parameters": {
							"filename": {
								"value": "@variables('filename')",
								"type": "Expression"
							},
							"foldername": {
								"value": "@variables('foldername')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "getQury",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "ForEach1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "qury",
					"value": {
						"value": "@concat('SELECT * FROM ',variables('tablename'),' WHERE ',variables('ingetioncol'),' = ','''',variables('ingetiondt'),'''')",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"tablename": {
				"type": "String"
			},
			"ingetioncol": {
				"type": "String"
			},
			"ingetiondt": {
				"type": "String"
			},
			"qury": {
				"type": "String"
			},
			"filename": {
				"type": "String"
			},
			"foldername": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2025-01-11T13:38:35Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
}