				"source": [
					"qry = f'''\r\n",
					"    CREATE DATABASE IF NOT EXISTS {silver_db}\r\n",
					"    LOCATION '{silver_path}' \r\n",
					"    '''\r\n",
					"spark.sql(qry)"
				],
				"execution_count": 84
			},
			{
				"cell_type": "code",
				"metadata": {
					"jupyter": {
						"source_hidden": false,
