				},
				"source": [
					"qry = f'''\r\n",
					"    CREATE TABLE IF NOT EXISTS {silver_db}.{silver_tbl}\r\n",
					"    USING Delta \r\n",
					"    LOCATION '{tbl_silver_path}'\r\n",
					"    '''\r\n",
					"spark.sql(qry)"
